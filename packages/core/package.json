{
  "name": "@chartzap/core",
  "version": "0.1.0",
  "private": true,
  "description": "Typed analytical formulas and semantic schema graphs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nickpad/chartzap.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./formula/ast": {
      "types": "./dist/formula/ast.d.ts",
      "import": "./dist/formula/ast.js"
    },
    "./formula/compile": {
      "types": "./dist/formula/compile.d.ts",
      "import": "./dist/formula/compile.js"
    },
    "./formula/column-refs": {
      "types": "./dist/formula/column-refs.d.ts",
      "import": "./dist/formula/column-refs.js"
    },
    "./formula/generated/formula": {
      "types": "./dist/formula/generated/formula.d.ts",
      "import": "./dist/formula/generated/formula.js"
    },
    "./functions": {
      "types": "./dist/functions/index.d.ts",
      "import": "./dist/functions/index.js"
    },
    "./functions/types": {
      "types": "./dist/functions/types.d.ts",
      "import": "./dist/functions/types.js"
    },
    "./functions/display": {
      "types": "./dist/functions/display.d.ts",
      "import": "./dist/functions/display.js"
    },
    "./functions/standard-type-check": {
      "types": "./dist/functions/standard-type-check.d.ts",
      "import": "./dist/functions/standard-type-check.js"
    },
    "./schema/graph": {
      "types": "./dist/schema/graph.d.ts",
      "import": "./dist/schema/graph.js"
    },
    "./schema/seed": {
      "types": "./dist/schema/seed.d.ts",
      "import": "./dist/schema/seed.js"
    },
    "./typechecker": {
      "types": "./dist/typechecker/index.d.ts",
      "import": "./dist/typechecker/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@lezer/common": "^1.4.0",
    "@lezer/lr": "^1.4.5",
    "tiny-invariant": "^1.3.3",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=22"
  }
}
