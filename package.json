{
  "name": "chartzap-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "lezer-generator packages/core/src/formula/formula.grammar -o packages/core/src/formula/generated/formula.js",
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "dev": "vite apps/playground --host 127.0.0.1",
    "build:playground": "vite build apps/playground",
    "test:integration": "vitest run --project integration",
    "test:packages": "node scripts/check-packages.mjs",
    "example": "node --import tsx examples/quickstart.ts"
  },
  "devDependencies": {
    "@chartzap/codemirror": "workspace:*",
    "@chartzap/core": "workspace:*",
    "@chartzap/postgres": "workspace:*",
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.1",
    "@codemirror/language": "^6.11.3",
    "@codemirror/lint": "^6.9.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.39.4",
    "@lezer/common": "^1.4.0",
    "@lezer/generator": "^1.8.0",
    "@lezer/highlight": "^1.2.3",
    "@lezer/lr": "^1.4.5",
    "@types/node": "^24.10.4",
    "@types/pg": "^8.15.4",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/browser-playwright": "^4.0.16",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.55.0",
    "pg": "^8.16.0",
    "playwright": "^1.57.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tiny-invariant": "^1.3.3",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.0.16",
    "vitest-browser-react": "^2.0.2",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0"
}
